# Copy to .env and fill in values
SESSION_SECRET=change_me_random_32chars
JIRA_SERVICE_TOKEN=change_me
CONFLUENCE_SERVICE_TOKEN=change_me
CONFLUENCE_BASE=https://confluence.ovhcloud.tools
# Optional — only needed by projects using Planning Light (see FUNCTIONAL_RULES.md). A BigPicture
# APIToken, not a Bearer/Jira token — generate it from BigPicture's own token settings, not Jira's.
BIGPICTURE_API_TOKEN=change_me
