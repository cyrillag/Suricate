<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= isPreview ? '[PREVIEW] ' : '' %><%= lang === 'fr' ? 'Connexion' : 'Sign in' %> — Suricate</title>
<link rel="stylesheet" href="/app.css">
<link rel="icon" type="image/png" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body class="auth-page">
<svg class="auth-deco" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none">
  <polygon points="100,100 100,40 55,100" fill="rgba(0,14,156,0.035)"/>
  <polygon points="100,100 100,60 75,100" fill="rgba(0,80,213,0.05)"/>
  <polygon points="0,0 40,0 0,30" fill="rgba(0,14,156,0.03)"/>
</svg>
<div class="lang-switch lang-switch-standalone">
  <a href="/lang/fr" class="lang-opt <%= lang==='fr' ? 'active' : '' %>">FR</a><span class="lang-sep">/</span><a href="/lang/en" class="lang-opt <%= lang==='en' ? 'active' : '' %>">EN</a>
</div>
<div class="auth-card">
  <div class="auth-brand">
    <img src="/logo-navy.png" height="60" alt="">
    <div class="brand-divider"></div>
    <div class="auth-brand-text">
      <h1 class="auth-title"><%= t('nav.brand') %></h1>
      <p class="auth-tagline"><%= t('nav.tagline') %></p>
    </div>
    <% if (isPreview) { %><span class="env-badge"<% if (typeof previewTitle !== 'undefined' && previewTitle) { %> title="<%= previewTitle %>"<% } %>><%= previewLabel || 'Preview' %></span><% } %>
  </div>
  <p class="auth-sub"><%= t('login.subtitle') %></p>
  <% if (error) { %><div class="auth-error"><%= error %></div><% } %>
  <form method="POST" action="/login" class="auth-form">
    <input type="hidden" name="returnTo" value="<%= returnTo %>">
    <label class="field-label" for="email"><%= t('login.email_label') %></label>
    <input class="field-input" type="email" id="email" name="email"
           placeholder="prenom.nom@ovhcloud.com" required autofocus autocomplete="email">
    <button type="submit" class="btn-primary btn-full"><%= t('login.submit') %></button>
  </form>
</div>
</body>
</html>
