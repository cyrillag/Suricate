<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= lang === 'fr' ? 'Connexion' : 'Sign in' %> — OVHcloud project reports</title>
<link rel="stylesheet" href="/app.css">
<link rel="icon" type="image/png" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body class="auth-page">
<svg class="auth-deco" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none">
  <polygon points="100,100 100,40 55,100" fill="rgba(0,14,156,0.035)"/>
  <polygon points="100,100 100,60 75,100" fill="rgba(0,80,213,0.05)"/>
  <polygon points="0,0 40,0 0,30" fill="rgba(0,14,156,0.03)"/>
</svg>
<div class="lang-switch lang-switch-standalone">
  <a href="/lang/fr" class="lang-opt <%= lang==='fr' ? 'active' : '' %>">FR</a><span class="lang-sep">/</span><a href="/lang/en" class="lang-opt <%= lang==='en' ? 'active' : '' %>">EN</a>
</div>
<div class="auth-card">
  <div class="auth-logo">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 298.03 47.18" height="32" fill="#000E9C" aria-label="OVHcloud">
