      <path d="M128.18,62.9c0-12.59,6.27-18.64,16.57-18.64s16.56,6.05,16.56,18.64S155,81.47,144.75,81.47,128.18,75.37,128.18,62.9Zm3.72,0c0,10.35,4.72,15.28,12.85,15.28s12.84-4.93,12.84-15.28-4.72-15.35-12.84-15.35S131.9,52.49,131.9,62.9Z" transform="translate(-36.97 -37.62)"/>
      <path d="M188.38,45.75a1.82,1.82,0,0,1,1.7-1.17,1.79,1.79,0,0,1,1.8,1.81,2.42,2.42,0,0,1-.16.79L179.3,79.93a1.78,1.78,0,0,1-3.39,0L163.49,47.18a2.42,2.42,0,0,1-.16-.79,1.79,1.79,0,0,1,1.8-1.81,1.82,1.82,0,0,1,1.7,1.17L177.6,74.31Z" transform="translate(-36.97 -37.62)"/>
      <path d="M199.42,64.06V79.35a1.81,1.81,0,1,1-3.61,0v-33a1.81,1.81,0,1,1,3.61,0V60.77H217.9V46.39a1.81,1.81,0,1,1,3.61,0v33a1.81,1.81,0,1,1-3.61,0V64.06Z" transform="translate(-36.97 -37.62)"/>
      <path d="M238.55,55.89a10,10,0,0,1,8.17,3.66c.24.32.37.68.37,1a1.54,1.54,0,0,1-2.81.9A6.8,6.8,0,0,0,238.55,59c-4.89,0-7.49,3.13-7.49,9.66s2.6,9.71,7.49,9.71a9.68,9.68,0,0,0,6.15-2.28,1.54,1.54,0,0,1,2.23,2.19,12.06,12.06,0,0,1-8,2.87c-6.85,0-10.94-4.09-10.94-12.79S231.7,55.89,238.55,55.89Z" transform="translate(-36.97 -37.62)"/>
      <path d="M255.48,44.63V75c0,2.12.69,3,2.12,3a1.6,1.6,0,1,1,0,3.19c-3.55,0-5.52-2.13-5.52-6.21V44.63a1.7,1.7,0,0,1,3.4,0Z" transform="translate(-36.97 -37.62)"/>
      <path d="M284.41,68.63c0,8.7-4.25,12.79-11.15,12.79s-11.14-4.09-11.14-12.79,4.3-12.74,11.14-12.74S284.41,59.92,284.41,68.63Zm-3.45,0c0-6.69-2.81-9.66-7.7-9.66s-7.69,3-7.69,9.66,2.81,9.71,7.69,9.71S281,75.42,281,68.63Z" transform="translate(-36.97 -37.62)"/>
      <path d="M292.59,57.91V71.76c0,3.45,1.11,6.42,6.47,6.42s6.48-3,6.48-6.42V57.91a1.69,1.69,0,0,1,3.4,0V71.76c0,5-1.65,9.66-9.88,9.66s-9.87-4.62-9.87-9.66V57.91a1.69,1.69,0,0,1,3.4,0Z" transform="translate(-36.97 -37.62)"/>
      <path d="M331.6,59.34V44.63a1.7,1.7,0,0,1,3.4,0V71c0,7-4.35,10.46-10.4,10.46-6.85,0-10.89-4.09-10.89-12.79s3.83-12.74,10.67-12.74A9,9,0,0,1,331.6,59.34Zm0,4.3s-2-4.67-7-4.67-7.49,3.13-7.49,9.66,2.6,9.71,7.49,9.71c4.08,0,7-2.33,7-7.38Z" transform="translate(-36.97 -37.62)"/>
    </svg>
  </div>
  <h1 class="auth-title"><%= t('nav.brand') %></h1>
  <p class="auth-sub"><%= t('login.subtitle') %></p>
  <% if (error) { %><div class="auth-error"><%= error %></div><% } %>
  <form method="POST" action="/login" class="auth-form">
    <input type="hidden" name="returnTo" value="<%= returnTo %>">
    <label class="field-label" for="email"><%= t('login.email_label') %></label>
    <input class="field-input" type="email" id="email" name="email"
           placeholder="prenom.nom@ovhcloud.com" required autofocus autocomplete="email">
    <button type="submit" class="btn-primary btn-full"><%= t('login.submit') %></button>
  </form>
</div>
</body>
</html>
