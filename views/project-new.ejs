<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= t('newProject.title') %> — OVHcloud project reports</title>
<link rel="stylesheet" href="/app.css">
</head>
<body>
<%- include('_nav', { userName, active: '' }) %>
<div class="app-body">
  <div class="page-header">
    <div>
      <a href="/" class="back-link"><%= t('newProject.back') %></a>
      <h1 class="page-title"><%= t('newProject.title') %></h1>
    </div>
  </div>
  <div class="form-card">
    <% if (error) { %><div class="auth-error"><%= error %></div><% } %>
    <form method="POST" action="/projects">
      <div class="field-group">
        <label class="field-step" for="name"><span class="step-num">1.</span> <%= t('newProject.step1') %> <span class="optional"><%= t('newProject.step1_opt') %></span></label>
        <input class="field-input" type="text" id="name" name="name" placeholder="Private boot M1" required autofocus>
      </div>
      <div class="field-group">
        <label class="field-step" for="jira_root_epic"><span class="step-num">2.</span> <%= t('newProject.step2') %> <span class="optional"><%= t('newProject.step2_opt') %></span></label>
        <input class="field-input" type="text" id="jira_root_epic" name="jira_root_epic" placeholder="LVL2-9365" required>
        <p class="field-hint"><%= t('newProject.step2_hint') %></p>
      </div>
      <div class="field-group">
        <label class="field-step" for="confluence_url"><span class="step-num">3.</span> <%= t('newProject.step3') %></label>
        <div class="format-callout">
          <%- t('newProject.callout') %>
          <a href="https://confluence.ovhcloud.tools/pages/viewpage.action?pageId=994384126" target="_blank" rel="noopener"><%= t('newProject.callout_link') %></a>
        </div>
        <input class="field-input" type="url" id="confluence_url" name="confluence_url"
               placeholder="https://confluence.ovhcloud.tools/display/CPO/Private+boot+-+M1" required>
        <p class="field-hint"><%= t('newProject.step3_hint') %></p>
      </div>
      <div class="field-group">
        <label class="field-step"><span class="step-num">4.</span> <%= t('newProject.step4') %></label>
        <p class="field-hint"><%= t('newProject.step4_hint') %></p>
      </div>
      <div class="form-actions">
        <a href="/" class="btn-ghost"><%= t('newProject.cancel') %></a>
        <button type="submit" class="btn-primary"><%= t('newProject.submit') %></button>
      </div>
    </form>
  </div>
</div>
</body>
</html>
