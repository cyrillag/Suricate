<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard — OVHcloud Reports</title>
<link rel="stylesheet" href="/app.css">
</head>
<body>
<%- include('_nav', { userName, active: 'dashboard' }) %>
<div class="app-body">
  <div class="page-header">
    <div>
      <h1 class="page-title">My projects</h1>
      <p class="page-sub">Weekly status reports for your OVHcloud projects</p>
    </div>
    <a href="/projects/new" class="btn-primary">+ New project</a>
  </div>

  <% if (projects.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📋</div>
    <h2>No projects yet</h2>
    <p>Create your first project to start generating weekly reports.</p>
    <a href="/projects/new" class="btn-primary">Create a project</a>
  </div>
  <% } else { %>
  <div class="project-grid">
    <% projects.forEach(p => { %>
    <div class="project-card">
      <div class="project-card-top">
        <div class="project-card-name"><%= p.name %></div>
        <div style="display:flex;align-items:center;gap:6px;flex-shrink:0">
          <span class="project-epic"><%= p.jira_root_epic %></span>
          <form method="POST" action="/projects/<%= p.slug %>/delete"
                onsubmit="return confirm('Delete project \'<%= p.name %>\' and all <%= p.report_count %> of its report(s)? This cannot be undone.');">
            <button type="submit" class="btn-ghost btn-sm btn-danger" title="Delete project" aria-label="Delete project <%= p.name %>">🗑</button>
          </form>
        </div>
      </div>
      <div class="project-card-meta">
        <%= p.report_count %> report<%= p.report_count !== 1 ? 's' : '' %>
        <% if (p.last_report) { %> · Last: <strong><%= p.last_report %></strong><% } %>
        <% if (p.eta) { %> · ETA <strong><%= p.eta %></strong><% } %>
      </div>
      <div class="project-card-actions">
        <form method="POST" action="/projects/<%= p.slug %>/reports/generate" style="display:inline">
          <input type="hidden" name="week" value="<%= currentWeek %>">
          <button type="submit" class="btn-primary btn-sm">Generate <%= currentWeek %></button>
        </form>
        <a href="/projects/<%= p.slug %>" class="btn-ghost btn-sm">View reports</a>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>
</body>
</html>
