<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= t('detail.missing_title', { week: weekStr }) %> — Suricate</title>
<link rel="stylesheet" href="/app.css">
<link rel="icon" type="image/png" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body>
<%- include('_nav', { userName }) %>
<div class="app-body">
  <div class="page-header">
    <div>
      <a href="/projects/<%= proj.slug %>" class="back-link">← <%= proj.name %></a>
    </div>
    <div class="week-nav">
      <a class="week-arrow" href="/projects/<%= proj.slug %>/<%= prevWeekStr %>" aria-label="Previous week">&#x2039;</a>
      <div class="ref-week"><%= weekStr %></div>
      <% if (nextWeekStr) { %>
      <a class="week-arrow" href="/projects/<%= proj.slug %>/<%= nextWeekStr %>" aria-label="Next week">&#x203A;</a>
      <% } else { %>
      <span class="week-arrow week-arrow-disabled" aria-disabled="true">&#x203A;</span>
      <% } %>
    </div>
  </div>

  <div class="empty-state">
    <div class="empty-icon">🗓️</div>
    <h2><%= t('detail.missing_title', { week: weekStr }) %></h2>
    <p><%= t('detail.missing_explanation') %></p>
  </div>
</div>
</body>
</html>
