<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= proj.name %> — Suricate</title>
<link rel="stylesheet" href="/app.css">
<link rel="icon" type="image/png" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body>
<%- include('_nav', { userName }) %>
<div class="app-body">
  <div class="page-header">
    <div>
      <a href="/" class="back-link"><%= t('newProject.back') %></a>
      <h1 class="page-title"><%= proj.name %></h1>
      <p class="page-sub">
        <span class="tag"><%= proj.jira_root_epic %></span>
        <% if (proj.confluence_page) { %><span class="tag"><%= proj.confluence_space %> / <%= proj.confluence_page %></span><% } %>
        <% if (proj.eta) { %><span class="tag">ETA <%= proj.eta %></span><% } %>
        <span class="tag"><%= wsCount %> workstreams</span>
        <span class="tag"><%= epicCount %> epics</span>
        <span class="tag"><%= t('detail.owner', { name: proj.owner_name }) %></span>
      </p>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:flex-end">
      <a href="/projects/<%= proj.slug %>/cleanup" class="btn-ghost btn-sm"><%= t('detail.cleanup_link') %></a>
    <% if (isOwner) { %>
      <a href="/projects/<%= proj.slug %>/edit" class="btn-ghost btn-sm btn-icon" title="<%= t('detail.configure') %>" aria-label="<%= t('detail.configure') %>"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-2px"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></a>
      <form method="POST" action="/projects/<%= proj.slug %>/reports/generate" style="display:flex;gap:6px;align-items:center">
        <input class="field-input" type="text" name="week" value="<%= currentWeek %>" pattern="\d{4}-W\d{2}" style="width:110px" title="<%= t('detail.week_input_title') %>" aria-label="<%= t('detail.week_input_aria') %>">
        <button type="submit" class="btn-primary"><%= t('detail.generate_report') %></button>
      </form>
    <% } %>
    </div>
  </div>

  <p class="page-sub" style="margin-top:-8px;margin-bottom:16px">
    <%= t('detail.auto_note', { source: proj.confluence_page ? t('detail.auto_note_confluence') : t('detail.auto_note_jira') }) %>
  </p>

  <% if (syncWarning && syncWarning.length) { %>
  <div class="auth-error">
    <% syncWarning.forEach(w => { %>
      <%# Each message already says what to do (retry, fix the page, renew a token…) — no blanket
          "retry by clicking Generate" suffix, which was wrong for most causes. %>
      <div>⚠ <% if (['jira', 'confluence', 'bigpicture'].includes(w.source)) { %><strong><%= t('detail.source_' + w.source) %></strong> — <% } %><%= w.message %></div>
    <% }) %>
  </div>
  <% } %>

  <div class="section-card">
    <div class="section-card-header"><%= t('detail.past_reports') %></div>
    <% if (reports.length === 0) { %>
    <div class="empty-state-inline"><%= isOwner ? t('detail.no_reports', { week: currentWeek }) : t('detail.no_reports_viewer') %></div>
    <% } else { %>
    <table class="simple-table">
      <thead><tr><th><%= t('detail.week_col') %></th><th></th></tr></thead>
      <tbody>
      <% reports.forEach(r => { const ws = `${r.year}-W${String(r.week).padStart(2,'0')}`; %>
      <% if (!r.exists) { %>
      <tr>
        <td><strong style="color:var(--tx3)"><%= ws %></strong></td>
        <td class="td-actions">
          <span class="empty-state-inline" style="padding:0;font-style:italic"><%= t('detail.no_report_row') %></span>
        </td>
      </tr>
      <% } else { %>
      <tr>
        <td><strong><%= ws %></strong><% if (r.backfilled) { %> <span class="tag" title="<%= t('detail.missing_generate_warning') %>"><%= t('detail.backfilled_tag') %></span><% } %></td>
        <td class="td-actions">
          <a href="/projects/<%= proj.slug %>/<%= ws %>" class="btn-ghost btn-sm"><%= t('detail.view') %></a>
          <% if (isOwner) { %>
          <% if (ws === currentWeek) { %>
          <form method="POST" action="/projects/<%= proj.slug %>/reports/generate" style="display:inline">
            <input type="hidden" name="week" value="<%= ws %>">
            <button type="submit" class="btn-ghost btn-sm"><%= t('detail.regenerate') %></button>
          </form>
          <% } %>
          <form method="POST" action="/projects/<%= proj.slug %>/reports/<%= ws %>/delete" style="display:inline" onsubmit="return confirm(<%= JSON.stringify(t('detail.delete_confirm', { week: ws })) %>);">
            <button type="submit" class="btn-ghost btn-sm btn-danger"><%= t('detail.delete') %></button>
          </form>
          <% } %>
        </td>
      </tr>
      <% } %>
      <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>
</body>
</html>
